            "type": "integer",
            "format": "int32"
          }
        },
        "additionalProperties": false
      },
      "DetalleReservaDto": {
        "type": "object",
        "properties": {
          "idFuncion": {
            "type": "integer",
            "format": "int32"
          },
          "idButaca": {
            "type": "integer",
            "format": "int32"
          },
          "idTipoEntrada": {
            "type": "integer",
            "format": "int32"
          },
          "precio": {
            "type": "number",
            "format": "double"
          },
          "idPromocion": {
            "type": "integer",
            "format": "int32",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "PostFacturaDto": {
        "type": "object",
        "properties": {
          "idCliente": {
            "type": "integer",
            "format": "int32"
          },
          "idFormaPago": {
            "type": "integer",
            "format": "int32"
          },
          "idCanalVenta": {
            "type": "integer",
            "format": "int32"
          },
          "detalles": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/DetalleReservaDto"
            },
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "PostFuncionDto": {
        "required": [
          "fecha",
          "subtitulada"
        ],
        "type": "object",
        "properties": {
          "fecha": {
            "type": "string",
            "format": "date-time"
          },
          "idHoraFuncion": {
            "maximum": 2147483647,
            "minimum": 1,
            "type": "integer",
            "format": "int32"
          },
          "subtitulada": {
            "type": "boolean"
          },
          "idPelicula": {
            "maximum": 2147483647,
            "minimum": 1,
            "type": "integer",
            "format": "int32"
          },
          "idSala": {
            "maximum": 2147483647,
            "minimum": 1,
            "type": "integer",
            "format": "int32"
          },
          "idIdioma": {
            "maximum": 2147483647,
            "minimum": 1,
            "type": "integer",
            "format": "int32"
          }
        },
        "additionalProperties": false
      },
      "PostPeliculaDto": {
        "required": [
          "fechaEstreno",
          "idsActores",
          "idsGeneros",
          "poster",
          "titulo"
        ],
        "type": "object",
        "properties": {
          "titulo": {
            "minLength": 1,
            "type": "string"
          },
          "duracion": {
            "maximum": 600,
            "minimum": 1,
            "type": "integer",
            "format": "int32"
          },
          "idClasificacion": {
            "maximum": 2147483647,
            "minimum": 1,
            "type": "integer",
            "format": "int32"
          },
          "idDirector": {
            "maximum": 2147483647,
            "minimum": 1,
            "type": "integer",
            "format": "int32"
          },
          "fechaEstreno": {
            "type": "string",
            "format": "date-time"
          },
          "poster": {
            "minLength": 1,
            "type": "string"
          },
          "sinopsis": {
            "type": "string",
            "nullable": true
          },
          "idsGeneros": {
            "type": "array",
            "items": {
              "type": "integer",
              "format": "int32"
            }
          },
          "idsActores": {
            "type": "array",
            "items": {
              "type": "integer",
              "format": "int32"
            }
          }
        },
        "additionalProperties": false
      },
      "PostReservaDto": {
        "type": "object",
        "properties": {
          "detalles": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/DetalleReservaDto"
            },
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "UserLoginDto": {
        "type": "object",
        "properties": {
          "userEmail": {
            "type": "string",
            "nullable": true
          },
          "password": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      }
    },
    "securitySchemes": {
      "Bearer": {
        "type": "http",
        "description": "Ingresá el JWT (sin el bearer).",
        "scheme": "bearer",
        "bearerFormat": "JWT"
